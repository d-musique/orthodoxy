prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
pluginbasedir=@ACTUAL_CLANG_PLUGIN_BASE_DIR_FOR_PKGCONFIG@
plugindir=${pluginbasedir}/@LLVM_MAJOR_VERSION@
pluginfile=${plugindir}/orthodoxy@CMAKE_SHARED_MODULE_SUFFIX@

Name: orthodoxy-for-clang@LLVM_MAJOR_VERSION@
Description: Clang plugin to enforce custom C++ feature restrictions
Version: @PROJECT_VERSION@
Cflags: -fplugin=${pluginfile}
